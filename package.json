{
  "name": "@giladbarnea/taller-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Balance Pi editor height with the available chat space.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giladbarnea/taller-editor.git"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "setup": "git config core.hooksPath .githooks",
    "preversion": "npm run check",
    "release": "npm version -m \"Release %s\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
